# ==============================================================================
# RANKFORGE VERSION CONTROL EXCLUSIONS (.gitignore)
# ==============================================================================

# Build Artifacts (Maven & Vite)
target/
**/target/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.class
*.jar.original

# Dependencies
node_modules/
**/node_modules/
.npm/

# Caches & Test Runtime
.vite/
**/.vite/
.vitest/
**/.vitest/
*.dump
*.dumpstream

# Persistent Database & Local Storage
data/
**/data/
*.mv.db
*.trace.db

# Secrets & Environment Variables
.env
.env.local
.env.*.local
*.env

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary & Experimental Backups
*.bak
*.backup
*~

# IDE, Editors & OS Files
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

